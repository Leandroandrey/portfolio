# Endereço público do site. Fica aqui, e não chumbado no index.html, porque
# og:image precisa ser URL ABSOLUTA — LinkedIn e WhatsApp ignoram caminho
# relativo e o preview sai sem imagem. O Vite troca %VITE_SITE_URL% no HTML
# durante o build.
#
# Trocou de domínio? É esta linha, e só ela.
#
# Nada de segredo aqui: tudo que começa com VITE_ vai pro bundle e fica
# visível pra quem abrir o site.
VITE_SITE_URL=https://portfolio.leandro-andrey81.workers.dev
